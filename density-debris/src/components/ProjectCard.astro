---
import "../styles/project-card.css";
import ProjectTags from "./ProjectTags.astro";
import { getCollection } from "astro:content";
import { existingProjectImage } from "../lib/project-image";

const projects = await getCollection("projects");
const visibleProjects = projects.filter((project) => project.data.visible);
---

{
    visibleProjects.map((project) => {
        const image = existingProjectImage(project.data.image);
        return (
        <article
            class="project-card"
            id={project.slug === "scoliosis-bot" ? "scoliosis-bot" : undefined}
        >
            <div class="text">
                <h3>{project.data.name}</h3>
                <p class="caption">{project.data.caption}</p>
            </div>
            {image && (
                <button
                    type="button"
                    class="project-image"
                    aria-label={`View full size: ${project.data.image_alt ?? project.data.name}`}
                >
                    <img src={image} alt="" width="960" height="640" />
                </button>
            )}
            <div class="content">
                <p class="description">{project.data.description}</p>
                <div class="tags-container">
                    <ProjectTags tags={project.data.tags} />
                </div>
                <div class="project-links">
                    {project.data.github_link && (
                        <a
                            href={project.data.github_link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            GitHub
                            <span aria-hidden="true">↗</span>
                        </a>
                    )}
                    {project.data.devpost_link && (
                        <a
                            href={project.data.devpost_link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Devpost
                            <span aria-hidden="true">↗</span>
                        </a>
                    )}
                </div>
            </div>
        </article>
        );
    })
}

<dialog id="project-image-modal" class="image-modal" aria-label="Full size project image">
    <button type="button" class="image-modal-close" aria-label="Close">×</button>
    <img alt="" />
</dialog>

<script src="/scripts/project-image.js" defer></script>
