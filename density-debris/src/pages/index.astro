---
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Amy Lee is a CS master's student at the University of Michigan. Projects in operating, distributed, and embedded systems, plus internships at AWS and Nexteer."
        />
        <title>Amy Lee</title>
        <script is:inline src="/scripts/theme.js"></script>
    </head>
    <body>
        <Header />
        <main>
                <h1><b>Amy Lee</b></h1>
                <p>
                    Hi, I'm Amy, a CS Master's student at the University of
                    Michigan. I recently graduated with a Bachelor's degree in CS
                    at the University of Michigan. I'm interested in
                    <span class="interest-rotator">
                        <span class="interest-static"
                            >operating, distributed, and embedded</span
                        >
                        <span class="interest-cycle" aria-hidden="true">
                            <span class="interest-sizer">operating</span>
                            <span class="interest-word is-shown">operating</span>
                        </span>
                    </span>
                    systems. I've previously interned at
                    AWS (x2) as a software engineering intern and Nexteer as an
                    embedded systems intern.
                </p>
                <p>For those curious, dark mode doesn't just dim this website.</p>
                <div class="origin-story">
                    <p>
                        <a href="#scoliosis-bot">Scoliosis Bot</a>, listed
                        below, was one of my first personal projects. During my
                        high school junior year I was trapped inside while the
                        pandemic raged outside, so I was glued to my desk all day.
                        My parents constantly commented about my poor posture. So I
                        set out to create a Discord bot that would remind me, at
                        random intervals throughout the day, to sit up. For a
                        nascent programmer, the canonical event of discovering Stack Overflow
                        was inevitable. (Of course, AI changed everything, but this
                        was 2021, in the pre-AI era.) At first, I only asked
                        questions. But over the span of several months the asking
                        turned into answering, and I became an avid participant in
                        the discord.js community while I tinkered away at the
                        Discord bot. I owe the Stack Overflow community a huge
                        thank you for the experience I gained in programming and
                        technical communication.
                    </p>
                    <p>
                        There's other projects below that represent a subset what
                        I've worked on since.
                    </p>
                </div>

            <h2 id="projects">Projects</h2>
            <div class="project-cards-container">
                <ProjectCard />
            </div>
        </main>
        <script>
            const cycle = document.querySelector(".interest-cycle");
            const sizer = document.querySelector(".interest-sizer");
            const words = ["operating", "distributed", "embedded"];
            const reduceMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            if (cycle && sizer && !reduceMotion) {
                let index = 0;

                function fit(text) {
                    sizer.textContent = text;
                    const probe = document.createElement("span");
                    probe.textContent = text;
                    probe.style.cssText =
                        "position:absolute;visibility:hidden;white-space:nowrap;pointer-events:none;";
                    cycle.parentElement.append(probe);
                    const width = Math.ceil(probe.getBoundingClientRect().width);
                    probe.remove();
                    cycle.style.width = `${width}px`;
                }

                function swap() {
                    index = (index + 1) % words.length;
                    const outgoing = cycle.querySelector(".interest-word.is-shown");
                    const incoming = outgoing.cloneNode(false);
                    incoming.classList.remove("is-shown");
                    incoming.textContent = words[index];
                    cycle.append(incoming);
                    fit(words[index]);
                    void incoming.offsetWidth;
                    incoming.classList.add("is-shown");
                    outgoing.classList.remove("is-shown");
                    window.setTimeout(() => outgoing.remove(), 500);
                }

                fit(words[0]);
                document.fonts?.ready.then(() => fit(words[index]));
                window.setInterval(swap, 2000);
            }
        </script>
    </body>
</html>

<style>
    .origin-story a:any-link {
        color: var(--accent);
    }

    .origin-story a:hover,
    .origin-story a:focus-visible {
        color: var(--accent-hover);
    }

    .interest-rotator {
        position: relative;
        color: var(--accent);
        font-weight: 600;
    }

    .interest-static {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .interest-cycle {
        display: inline-grid;
        vertical-align: baseline;
        overflow: hidden;
        transition: width 0.45s ease;
    }

    .interest-sizer,
    .interest-word {
        grid-area: 1 / 1;
        min-width: 0;
        white-space: nowrap;
    }

    .interest-sizer {
        visibility: hidden;
    }

    .interest-word {
        opacity: 0;
        transition: opacity 0.45s ease;
    }

    .interest-word.is-shown {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .interest-static {
            position: static;
            width: auto;
            height: auto;
            margin: 0;
            overflow: visible;
            clip: auto;
            white-space: normal;
        }

        .interest-cycle {
            display: none;
        }

        .interest-word,
        .interest-cycle {
            transition: none;
        }
    }
</style>
